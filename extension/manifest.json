{
  "manifest_version": 3,
  "name": "红桥房源采集助手",
  "short_name": "红桥采集",
  "version": "0.5",
  "description": "点击图标即采集当前贝壳/我爱我家单套房源并直传云端；失败自动重试。",
  "minimum_chrome_version": "110",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://hongqiao-housing-watch.netlify.app/*"
  ],
  "action": {
    "default_title": "一键采集并同步房源"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}

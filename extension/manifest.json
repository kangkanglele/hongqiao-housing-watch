{
  "manifest_version": 3,
  "name": "红桥房源采集助手",
  "short_name": "红桥采集",
  "version": "0.6",
  "description": "点击扩展图标自动采集房源；弹窗显示进度，页面悬浮提示同步状态。",
  "minimum_chrome_version": "110",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://hongqiao-housing-watch.netlify.app/*"
  ],
  "action": {
    "default_title": "一键采集并同步房源",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  }
}
